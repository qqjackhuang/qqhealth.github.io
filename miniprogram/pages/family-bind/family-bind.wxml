<view class="page">
  <view class="card">
    <view class="field">
      <view class="label">请输入家庭邀请码</view>
      <input class="input" placeholder="例如 QQ-8821" value="{{code}}" bindinput="onCode" />
    </view>
    <view class="btn block" bindtap="submit">确认绑定</view>
  </view>
  <view class="muted">{{hint}}</view>
</view>
