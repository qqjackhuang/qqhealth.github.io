<view class="section">
  <view wx:if="{{!list.length}}" class="empty"><text class="t">还没有发布房源</text>点击底部「发布」即可出售</view>
  <view class="card" wx:for="{{list}}" wx:key="id">
    <view style="font-size:30rpx;font-weight:650;">{{item.title}}</view>
    <view class="meta">{{item.rooms}} · {{item.area}}㎡ · {{item.price}}万</view>
    <view class="cta" style="padding: 16rpx 0 0;">
      <view class="btn btn-ghost btn-sm" data-id="{{item.id}}" bindtap="goDetail">查看</view>
      <view class="btn btn-ghost btn-sm" data-id="{{item.id}}" bindtap="remove">下架</view>
    </view>
  </view>
</view>
