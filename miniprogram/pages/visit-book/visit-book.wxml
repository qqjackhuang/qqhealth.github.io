<view class="page">
  <view class="card">
    <view class="field">
      <view class="label">探望日期</view>
      <picker mode="date" value="{{date}}" bindchange="onDate">
        <view class="picker">{{date}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">到达时间</view>
      <picker mode="time" value="{{time}}" bindchange="onTime">
        <view class="picker">{{time}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">探望人</view>
      <input class="input" value="{{who}}" bindinput="onWho" />
    </view>
    <view class="field">
      <view class="label">备注</view>
      <input class="input" placeholder="人数、是否用餐、需要协助" value="{{note}}" bindinput="onNote" />
    </view>
    <view class="btn block" bindtap="submit">提交预约</view>
  </view>
  <view class="muted">前台会在预约时段引导入户。演示数据保存在本机，刷新后仍可看到。</view>
</view>
