<view class="profile-head">
  <view class="avatar">{{avatar}}</view>
  <view>
    <view style="font-size:36rpx;font-weight:700;">{{profile.name}}</view>
    <view style="opacity:0.85;font-size:26rpx;margin-top:8rpx;">{{profile.phone || '尚未完善联系方式'}}</view>
  </view>
</view>
<view class="stats" style="padding: 24rpx 32rpx 0;">
  <view class="stat"><view class="b">{{interestsCount}}</view><view class="s">购买意向</view></view>
  <view class="stat"><view class="b">{{mineCount}}</view><view class="s">在售房源</view></view>
  <view class="stat"><view class="b">{{total}}</view><view class="s">社区房源</view></view>
</view>
<view class="menu">
  <view class="menu-item" bindtap="goInterests">我的购买意向<text class="r">{{interestsCount}} 条 ›</text></view>
  <view class="menu-item" bindtap="goMine">我发布的房源<text class="r">{{mineCount}} 套 ›</text></view>
  <view class="menu-item" bindtap="goInterest">去登记意向<text class="r">›</text></view>
  <view class="menu-item" bindtap="goPublish">发布出售<text class="r">›</text></view>
  <view class="menu-item" bindtap="goApplications">入驻申请 / 审核<text class="r">{{applyCount}} 条 ›</text></view>
</view>
<view class="section">
  <view class="box">置业顾问热线 {{hotline}}
本演示数据保存在本机，刷新不会丢失。</view>
</view>
