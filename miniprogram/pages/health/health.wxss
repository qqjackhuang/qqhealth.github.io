.btn.mini {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
}

.metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.metric {
  background: #fbf6f0;
  border-radius: 20rpx;
  padding: 20rpx;
  width: calc(50% - 8rpx);
  box-sizing: border-box;
}

.num {
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.med-name {
  font-weight: 650;
}
