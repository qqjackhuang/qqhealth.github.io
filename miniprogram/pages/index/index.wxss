.role-swiper {
  margin: 16rpx 32rpx 0;
  height: 420rpx;
  border-radius: 32rpx;
  overflow: hidden;
}
.role-slide {
  height: 420rpx;
  position: relative;
}
.role-slide image { width: 100%; height: 100%; }
.role-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(42,36,32,0.08) 18%, rgba(42,36,32,0.78) 100%);
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  color: #fff;
}
.role-mask .cta-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  opacity: 0.95;
}
